---
import Layout from '../layouts/Layout.astro';
---

<Layout
        title="Red Dead Bonuses | 2 Smokin' Barrels"
        description="Complete Moonshiner Sales to earn 3X RDO$, Role XP, and XP all month, with additional bonuses in Moonshiner Story Missions and Free Roam Missions."
        image="https://2smokinbarrels.com/images/rdo-bonuses-banner.jpg"
    >
    <main class="container">
        
        <header style="margin-bottom: 3rem;">
            <h1 class="page-title">Red Dead Monthly</h1>
            <p class="date-range" style="text-align: center; color: var(--white-med); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">September 1, 2026 — October 5, 2026</p>
            
        <!-- Modernized Highlight Box -->
        <div style="background: rgba(38, 30, 62, 0.4); 
                    border-left: 5px solid var(--accent-pink); 
                    padding: 25px; 
                    margin-top: 20px; 
                    text-align: left; 
                    border-radius: 12px; 
                    backdrop-filter: blur(10px); 
                    border: 1px solid rgba(255, 255, 255, 0.05);">
                <p style="margin: 0; font-size: 1.1rem; color: var(--white-low);">
                    Earn <span style="color: var(--accent-orange); font-weight: 700;">3X RDO$, Role XP & XP</span> on Moonshiner Sales & Moonshiner Story Missions all month. 
                    Free Roam Missions and the Featured Series are also paying out a massive <span style="color: var(--accent-pink); font-weight: 700;">3X RDO$ & XP</span>. 
                    Plus, enjoy a <span style="color: var(--accent-pink); font-weight: 700;">FREE Moonshine Shack Relocation</span>!
                </p>
            </div>
        </header>

        <div class="bonus-grid">
            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Current Bonuses</h3>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$, Role XP & XP</strong> on Moonshiner Sales & Story Missions</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$ & XP</strong> on Free Roam Missions</div>
                <div class="bonus-item"><span class="multiplier">3X</span> <strong>RDO$ & XP</strong> on Featured Series</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Monthly Rewards</h3>
                <div class="bonus-item"><strong>Zapatero Outfit & Golden Spirit Buckle:</strong> Log in at Rank 50+.</div>
                <div class="bonus-item"><strong>Emerald Ranch & Falls Photographs:</strong> Log in as a Moonshiner.</div>
                <div class="bonus-item"><strong>Tan Porter Jacket:</strong> Win in the Featured Series.</div>
                <div class="bonus-item"><strong>Black & Red Carbow Bandolier:</strong> Complete 3 Daily Challenges.</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Weekly Rewards</h3>
                <p style="font-size: 0.8rem; font-style: italic; margin-bottom: 10px; color: var(--accent-pink);">Complete a Moonshiner Sale each week to receive:</p>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 1 - 7:</span> Ta-Da Emote</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 8 - 14:</span> This Guy Emote</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 15 - 21:</span> Black Woodland Gloves</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 22 - 28:</span> Blue Plaid Cap</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 29 - Oct 5:</span> Black Winter Shotgun Coat</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Featured Series</h3>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 1 - 7:</span> Hardcore Plunder & Spoils of War</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 8 - 14:</span> Lemoyne Series</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 15 - 21:</span> Hardcore Last Stand</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 22 - 28:</span> Ambarino Series</div>
                <div class="bonus-item"><span class="date-range" style="color: var(--accent-pink);">Sept 29 - Oct 5:</span> Hardcore Pro Series</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Discounts</h3>
                <div class="bonus-item"><span style="color: var(--accent-orange);">FREE:</span> Moonshine Shack Relocation Fee</div>
                <div class="bonus-item"><span style="color: var(--accent-orange);">10 GOLD OFF:</span> Moonshine Shack</div>
                <div class="bonus-item"><span style="color: var(--accent-orange);">5 GOLD OFF:</span> Moonshiner Bar Décor</div>
                <div class="bonus-item"><span style="color: var(--accent-orange);">50% OFF:</span> Bar Expansion, Repeaters & Customizations</div>
                <div class="bonus-item"><span style="color: var(--accent-orange);">40% OFF:</span> Moonshiner Outfits, Norfolk & Arabian Horses, Shirts, Corsets & Dresses</div>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Returning Clothing</h3>
                <ul style="list-style: none; padding: 0; margin: 0;">
                    <li class="bonus-item">Lister Hat & Owanjila Hat</li>
                    <li class="bonus-item">Chambliss Corset</li>
                    <li class="bonus-item">Charro Jacket & Leavitt Jacket</li>
                </ul>
            </div>

            <div class="bonus-card">
                <h3 style="font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; color: var(--accent-orange); text-shadow: 0 0 8px rgba(255, 140, 27, 0.4);">Community Outfit</h3>
                <p style="font-size: 0.8rem; font-style: italic; margin-bottom: 10px; color: var(--accent-pink);">By nerdygeekybisaya</p>
                <div class="bonus-item">Doily Shirtwaist (F) or Everyday Shirt (M)</div>
                <div class="bonus-item">Opulent Vest</div>
                <div class="bonus-item">Folded String Tie</div>
                <div class="bonus-item">Bandito Pants</div>
                <div class="bonus-item">Worn Roper Boots</div>
            </div>
        </div>
        
        <div style="margin-top: 4rem; text-align: center;">
            <a href="/" style="color: var(--accent-pink); text-decoration: none; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">&larr; Back to Home</a>
        </div>
    </main>
</Layout>